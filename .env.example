# Local environment configuration for weed-detector
# Copy this file to .env and replace the placeholder values with your DagsHub credentials.

DAGSHUB_REPO_URL=https://dagshub.com/synapsy4/weed-detector
DAGSHUB_TOKEN=replace-with-your-dagshub-token
MLFLOW_TRACKING_URI=https://dagshub.com/synapsy4/weed-detector.mlflow
MLFLOW_TRACKING_TOKEN=replace-with-your-dagshub-token
MLFLOW_EXPERIMENT_NAME=weed-detector
DVC_REMOTE_URL=https://dagshub.com/synapsy4/weed-detector.dvc

# --- Prediction API (runtime) ---
# DagsHub token used non-interactively by the API container to read the model registry.
# (Without it, set MLFLOW_TRACKING_USERNAME / MLFLOW_TRACKING_PASSWORD instead.)
DAGSHUB_USER_TOKEN=replace-with-your-dagshub-token
# Enables POST /admin/reload (reachable only inside the Docker network). Leave empty to disable.
ADMIN_TOKEN=
# Seconds between registry checks while the production model is served / otherwise
MODEL_REFRESH_SECONDS=300
MODEL_RETRY_SECONDS=30
